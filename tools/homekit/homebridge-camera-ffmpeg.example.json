{
  "platform": "Camera-ffmpeg",
  "name": "Camera FFmpeg",
  "porthttp": 8899,
  "localhttp": true,
  "cameras": [
    {
      "name": "Cat Feeder",
      "manufacturer": "WOPET",
      "model": "Camera Pet Feeder",
      "motion": true,
      "motionTimeout": 30,
      "videoConfig": {
        "source": "-rtsp_transport tcp -i rtsp://192.0.2.100:8554/wopet",
        "maxWidth": 1280,
        "maxHeight": 720,
        "maxFPS": 15,
        "audio": false,
        "recording": true,
        "prebuffer": false,
        "returnAudioTarget": "-codec:a pcm_alaw -ar 8000 -ac 1 -f alaw -content_type audio/PCMA -method POST http://192.0.2.100:1986/talk?token=REPLACE_WITH_CONTROL_TOKEN"
      }
    }
  ]
}
