#!/usr/bin/with-contenv bashio
set -euo pipefail

camera_ip="$(bashio::config 'camera_ip')"
device_uid="$(bashio::config 'device_uid')"
device_username="$(bashio::config 'device_username')"
device_password="$(bashio::config 'device_password')"
stream_name="$(bashio::config 'stream_name')"
rtsp_port="$(bashio::config 'rtsp_port')"
log_level="$(bashio::config 'log_level')"
control_port="$(bashio::config 'control_port')"
preload_stream="true"
if bashio::config.exists 'preload_stream' && ! bashio::config.true 'preload_stream'; then
    preload_stream="false"
fi

go2rtc_log_level="info"
if [[ "${log_level}" == "debug" ]]; then
    go2rtc_log_level="debug"
fi

if [[ -z "${camera_ip}" || -z "${device_uid}" || -z "${device_username}" || -z "${device_password}" ]]; then
    bashio::log.fatal "camera_ip, device_uid, device_username, and device_password are required"
    exit 1
fi

if [[ ! "${stream_name}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    bashio::log.fatal "stream_name may contain only letters, numbers, underscores, and hyphens"
    exit 1
fi

cat > /data/go2rtc.yaml <<EOF
api:
  listen: ":1985"
log:
  level: "${go2rtc_log_level}"
  exec: "${go2rtc_log_level}"
  rtsp: "${go2rtc_log_level}"
  streams: "${go2rtc_log_level}"
rtsp:
  listen: ":${rtsp_port}"
streams:
  ${stream_name}:
    # killsignal must be numeric: go2rtc parses it with Atoi, so "SIGTERM" became
    # signal 0 and stopped producers were never killed (orphaned sessions).
    - "exec:python3 /app/wopet/wopet_stream.py#killsignal=15#killtimeout=8"
EOF

if [[ "${preload_stream}" == "true" ]]; then
    # Keep one feeder session open. Starting it takes 3-5 s; RTSP clients that give
    # up sooner would otherwise start and kill a session each time they retry.
    printf 'preload:\n  %s: "video"\n' "${stream_name}" >> /data/go2rtc.yaml
fi

export WOPET_OPTIONS_FILE=/data/options.json
bashio::log.info "Starting local bridge for stream '${stream_name}'"
bashio::log.info "RTSP is available on port ${rtsp_port}; credentials are intentionally omitted from logs"
bashio::log.info "Authenticated controls are available on port ${control_port}"
exec /usr/local/bin/go2rtc -config /data/go2rtc.yaml
